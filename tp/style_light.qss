QListWidget {
    background: #ffffff;
    color: #1a1a2e;
    border: 1px solid #b0bdd4;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: #c5cfe0;
    color: #1a1a2e;
}

QTextEdit {
    background: #ffffff;
    color: #1a1a2e;
    border: 1px solid #b0bdd4;
    border-radius: 6px;
}

QScrollBar:vertical {
    background: #dde3ec;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #b0bdd4;
    border-radius: 5px;
}

/* SpinRow label in light theme */
QFrame#SpinPill {
    background: #2d3748;
    border-radius: 28px;
    border: none;
}
