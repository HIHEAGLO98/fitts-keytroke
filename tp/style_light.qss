/* Light theme */
QWidget {
    background: #f0f2f5;
    color: #1a1a2e;
    font-family: 'Arial', 'Helvetica Neue', 'Liberation Sans', sans-serif;
    font-size: 15px;
}

QLabel#TitleLabel {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 32px;
    color: #1a1a2e;
}

QPushButton {
    background: #dde3ec;
    color: #1a1a2e;
    border: none;
    border-radius: 22px;
    padding: 32px 0;
    font-size: 22px;
    font-weight: 600;
    margin: 12px;
    qproperty-iconSize: 48px 48px;
}
QPushButton:hover {
    background: #c5cfe0;
    color: #1a5276;
}
QPushButton:focus {
    outline: none;
}
QPushButton::icon {
    background: transparent;
}
QPushButton:pressed {
    background: #b0bdd4;
}

QGroupBox {
    border: 1.5px solid #b0bdd4;
    border-radius: 18px;
    margin-top: 18px;
    padding: 18px 16px 12px 16px;
}
QGroupBox:title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #1a6b8a;
    background: transparent;
    font-size: 16px;
    font-weight: 600;
}

QLabel {
    background: transparent;
    color: #1a1a2e;
}

QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    color: #1a1a2e;
    border-radius: 10px;
    border: 1px solid #b0bdd4;
    padding: 4px 8px;
}

QLineEdit, QComboBox {
    background: #ffffff;
    color: #1a1a2e;
    border-radius: 10px;
    border: 1px solid #b0bdd4;
    padding: 4px 8px;
}

#StatsFields QLineEdit, #StatsFields QComboBox {
    background: #ffffff;
    color: #1a1a2e;
    border-radius: 10px;
    border: 1.5px solid #1a6b8a;
    padding: 6px 12px;
    font-size: 16px;
    margin: 0 6px;
}
#StatsFields QLabel {
    color: #1a6b8a;
    font-weight: 600;
    margin: 0 6px;
}

QSlider::groove:horizontal {
    border: 1px solid #b0bdd4;
    height: 8px;
    background: #dde3ec;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #1a6b8a;
    border: 1px solid #b0bdd4;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QMessageBox {
    background: #ffffff;
    color: #1a1a2e;
    border-radius: 16px;
}

QMenuBar {
    background: #dde3ec;
    color: #1a1a2e;
}
QMenuBar::item:selected {
    background: #c5cfe0;
}
QMenu {
    background: #ffffff;
    color: #1a1a2e;
    border: 1px solid #b0bdd4;
}
QMenu::item:selected {
    background: #c5cfe0;
}

