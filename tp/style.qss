/* Modern sleek style for the application */
QWidget {
    background: #1a1a1a;
    color: #f3f3f3;
    font-family: 'Arial', 'Helvetica Neue', 'Liberation Sans', sans-serif;
    font-size: 15px;
}

QLabel#TitleLabel {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 32px;
    color: #f3f3f3;
}

QPushButton {
    background: #232a34;
    color: #f3f3f3;
    border: none;
    border-radius: 22px;
    padding: 32px 0;
    font-size: 22px;
    font-weight: 600;
    margin: 12px;
    /* transition: background 0.2s; */
    qproperty-iconSize: 48px 48px;
}
QPushButton:hover {
    background: #2d3a4b;
    color: #7fd1b9;
}
QPushButton:focus {
    outline: none;
}

/* Force icon color to match text using SVG mask technique */
QPushButton::icon {
    background: transparent;
}

QPushButton:pressed {
    background: #16202a;
}

QGroupBox {
    border: 1.5px solid #444;
    border-radius: 18px;
    margin-top: 18px;
    padding: 18px 16px 12px 16px;
}
QGroupBox:title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #7fd1b9;
    background: transparent;
    font-size: 16px;
    font-weight: 600;
}
QLabel {
    background: transparent;
    color: #f3f3f3;
}

QSpinBox, QDoubleSpinBox {
    background: #232a34;
    color: #e0e0e0;
    border-radius: 10px;
    border: 1px solid #444;
    padding: 4px 8px;
}

QLineEdit, QComboBox {
    background: #232a34;
    color: #e0e0e0;
    border-radius: 10px;
    border: 1px solid #444;
    padding: 4px 8px;
}

/* Stats screen fields */
#StatsFields QLineEdit, #StatsFields QComboBox {
    background: #232a34;
    color: #e0e0e0;
    border-radius: 10px;
    border: 1.5px solid #7fd1b9;
    padding: 6px 12px;
    font-size: 16px;
    margin: 0 6px;
}
#StatsFields QLabel {
    color: #7fd1b9;
    font-weight: 600;
    margin: 0 6px;
}

QSlider::groove:horizontal {
    border: 1px solid #444;
    height: 8px;
    background: #232a34;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #7fd1b9;
    border: 1px solid #444;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QMessageBox {
    background: #232a34;
    color: #f3f3f3;
    border-radius: 16px;
}
